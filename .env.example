# Copy to .env and adjust. Never commit the real .env
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Public base URL used to build short links and QR codes
SHORT_BASE_URL=http://localhost:8000

# DATABASE_URL is REQUIRED when DJANGO_DEBUG=false (production). In local debug mode SQLite (db.sqlite3) is used.
# DATABASE_URL=postgres://snipr:snipr@db:5432/snipr
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# Number of trusted reverse proxies (nginx/ALB/Cloudflare) in front of the app
NUM_PROXIES=0

# GeoIP: free licence key from https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=
GEOIP_COUNTRY_DB=geoip/GeoLite2-Country.mmdb

# Rate limits (django-ratelimit syntax: N/s|m|h|d)
REDIRECT_RATE_LIMIT=300/m
API_RATE_LIMIT=300/m
LINK_CREATE_RATE_LIMIT=60/m
BULK_IMPORT_RATE_LIMIT=10/h
AUTH_RATE_LIMIT=10/m
UNLOCK_RATE_LIMIT=5/m

CLICK_RETENTION_DAYS=365
BLOCKED_DOMAINS=

# Local development WITHOUT a Celery worker: run tasks inline (never use in production)
CELERY_TASK_ALWAYS_EAGER=false
# Seconds analytics responses are cached (3 = near real-time dashboard, 30 = lighter DB load)
ANALYTICS_CACHE_TTL=30

# Login page brute-force limit (per IP and per username)
LOGIN_RATE_LIMIT=10/m
# Hard cap of links per account (also bounds bulk imports)
MAX_LINKS_PER_USER=10000
# Bulk import: each distinct password costs one slow PBKDF2 hash
BULK_IMPORT_MAX_ROWS=5000
BULK_IMPORT_MAX_DISTINCT_PASSWORDS=500
BULK_IMPORT_SOFT_TIME_LIMIT=1500
BULK_IMPORT_STUCK_MINUTES=30
